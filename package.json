{
  "name": "hyper3d-cli-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "zod": "^4.0.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p packages/cli/tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p packages/cli/tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "cli": "npm run build --silent && node packages/cli/dist/index.js",
    "pack:check": "npm run build && npm pack --workspace @hyper3d/cli --dry-run",
    "test:install": "node scripts/test-install.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
