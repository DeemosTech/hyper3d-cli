              },
              "total": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": ["name", "current", "total"],
            "additionalProperties": false
          },
          "error": {
            "type": "string"
          }
        },
        "required": ["generation_id", "status", "stage"],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "execution": {
