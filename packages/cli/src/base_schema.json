{
  "tools": [
    {
      "name": "rodin_list_animation_presets",
      "title": "List Rodin rigging animation presets",
      "description": "Legacy preset discovery. Omit category to receive the catalog category names; supply a category to receive its permanent animation_id values. The human_sp category remains accepted as an alias for human. Use rodin_list_animation_catalog for animation metadata. Legacy StandardAnimation aliases remain accepted by rodin_generate_rigging. This reads the preset catalog only and does not generate or modify models or consume credits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "animations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": ["rodin:read"]
          }
        ]
      }
    },
    {
      "name": "rodin_list_uploads",
      "title": "List saved Rodin library files",
      "description": "List files the user saved in their Hyper3D library, newest first. Pass returned upload_id values instead of uploading the same files again: kind=animation to rodin_generate_rigging.animation_upload_ids, kind=model to rodin_generate_rigging.model_upload_id, kind=image to reference_upload_ids. Reads the library only and does not consume credits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["image", "model", "animation"],
            "description": "Only files of this kind."
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Only files carrying this exact tag."
          },
          "page": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "default": 1
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "upload_id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "format": {
                  "type": ["string", "null"]
                },
                "name": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "upload_id",
                "kind",
                "format",
                "name",
                "tags",
                "created_at"
              ],
              "additionalProperties": false
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["files", "total"],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": ["rodin:read"]
          }
        ]
      }
    },
    {
      "name": "rodin_create_uploads",
      "title": "Create Rodin file uploads",
      "description": "Create one-hour presigned PUT URLs for one batch of files of the same kind. kind defaults to image: 1-5 images (JPEG, PNG, WebP, GIF, TIFF, AVIF or HEIC), at most 25 MiB each, for rodin_generate.reference_upload_ids or rodin_generate_agentic.reference_upload_ids. kind=model: one mesh (GLB, OBJ, STL, FBX or USD), at most 128 MiB, for rodin_generate_rigging.model_upload_id. kind=animation: 1-10 FBX files, at most 25 MiB each, for rodin_generate_rigging.animation_upload_ids; each FBX must contain exactly one animation clip (Take). PUT exactly size_bytes bytes with the returned headers before passing an ID to generation. The format is detected from the uploaded bytes. An uploaded ID can be reused by later generations until it expires, so do not upload the same file twice. If you cannot complete the HTTP PUT uploads, explain the limitation to the user in their language and suggest continuing at https://hyper3d.ai. In ChatGPT Chat mode, also suggest trying Work mode.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["image", "model", "animation"],
            "description": "Kind of every file in the batch. Defaults to image."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "description": "Filename without a directory path. OBJ, STL and USDZ meshes need their extension."
                },
                "size_bytes": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 134217728,
                  "description": "Exact file size in bytes, within the limit of its kind."
                }
              },
              "required": ["filename", "size_bytes"],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 10,
            "description": "One batch of the selected kind: 1-5 images, 1 model or 1-10 animations."
          }
        },
        "required": ["files"],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "uploads": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "upload_id": {
                  "type": "string"
                },
                "upload_url": {
                  "type": "string",
                  "format": "uri"
                },
                "method": {
                  "type": "string",
                  "const": "PUT"
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "expires_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "upload_id",
                "upload_url",
                "method",
                "headers",
                "expires_at"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["uploads"],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": ["rodin:generate"]
          }
        ]
      }
    },
    {
      "name": "rodin_generate",
      "title": "Generate a Rodin 3D model",
      "description": "Use this tool for text-only generation or image-based subjects whose defining geometry is not well suited to procedural n-gons modeling, such as detailed sculpted characters, garments, or realistic car bodies. Prefer rodin_generate_agentic for subjects with clear geometric construction, even when the image shows a single, clear object. For multi-view collages or design concept sheets, first crop the relevant views locally into separate reference images with one clear subject per image, or use rodin_generate_agentic directly; image layout alone does not determine the best tool. Start a Rodin Gen-2.5 generation from a non-empty prompt, one or more reference images, or both. At least one of prompt or reference_upload_ids is required. texture_delight defaults to false; setting it to true is recommended when reference images contain highly reflective surfaces. This consumes credits. The response includes display_url; present that URL only after the generation completes. If this call times out, do not retry it automatically; ask the user to check Hyper3D Mine.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "A non-empty text description. Required when reference_upload_ids is omitted."
          },
          "reference_upload_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{21}[AEIMQUYcgkosw048]$"
            },
            "minItems": 1,
            "maxItems": 5,
            "description": "One to five uploaded reference image IDs. Required when prompt is omitted."
          },
          "mesh_mode": {
            "type": "string",
            "enum": ["Raw", "Quad"],
            "default": "Raw"
          },
          "tier": {
            "type": "string",
            "enum": ["Gen-2.5-Medium", "Gen-2.5-High", "Gen-2.5-Extreme-Low"],
            "default": "Gen-2.5-Medium"
          },
          "texture_delight": {
            "type": "boolean",
            "default": false,
            "description": "Enable texture de-lighting. Defaults to false; recommended when reference images contain highly reflective surfaces."
          },
          "quality_override": {
            "type": "integer",
            "minimum": 500,
            "maximum": 1000000,
            "description": "Target polygon count. Raw accepts 500 to 1,000,000; Quad accepts 1,000 to 50,000."
          },
          "geometry_file_format": {
            "type": "string",
            "enum": ["glb", "usdz", "fbx", "obj", "stl"],
            "default": "glb"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generation_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "const": "queued"
          },
          "display_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["generation_id", "status", "display_url"],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": ["rodin:generate"]
          }
        ]
      }
    },
    {
      "name": "rodin_generate_agentic",
      "title": "Generate a 3D model with Agentic mode",
      "description": "Prefer this tool for subjects whose defining shapes, proportions, and negative spaces can be expressed with editable n-gons and procedural construction using primitives, extrusions, profiles, sweeps, repetition, or booleans, such as simple furniture, geometric props, and robots made of separate housings and uniform links. Judge the geometry rather than the category: hard-surface objects are not always easy, and organic objects are not always unsuitable. Detailed figurative sculpting, fitted anatomical shells, tension-shaped soft assemblies, garments, and realistic car bodies are generally better suited to rodin_generate. Accepts ordinary single-subject images as well as multi-view collages and design concept sheets; these layouts alone do not guarantee suitability. Agentic mode is beta: reference fidelity and structural results may fall short of expectations. Explain these limitations to the user before submitting. Automatically choose the Rodin high-poly or Agentic n-gons pipeline from 1-5 reference images and export the final model. First upload images with rodin_create_uploads and HTTP PUT, then pass their IDs. An omitted or blank prompt is derived from the images. This consumes credits. Use rodin_get_status or rodin_wait to track completion, then rodin_get_result for downloads. If status is unknown, stop waiting and check rodin_get_result; do not resubmit automatically. Present display_url only after completion. If submission times out, do not retry automatically; ask the user to check Hyper3D Mine.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reference_upload_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{21}[AEIMQUYcgkosw048]$"
            },
            "minItems": 1,
            "maxItems": 5
          },
          "prompt": {
            "type": "string",
            "maxLength": 1024,
            "default": ""
          },
          "tier": {
            "type": "string",
            "enum": ["basic", "standard", "pro"],
            "default": "standard"
          },
          "export_type": {
            "type": "string",
            "enum": ["glb", "usdz", "fbx", "stl"],
            "default": "glb"
          }
        },
        "required": ["reference_upload_ids"],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generation_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "const": "queued"
          },
          "display_url": {
            "type": "string",
            "format": "uri"
          },
          "producer": {
            "type": "string",
            "enum": ["high-poly", "n-gons"]
          }
        },
        "required": ["generation_id", "status", "display_url", "producer"],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": ["rodin:generate"]
          }
        ]
      }
    },
    {
      "name": "rodin_generate_rigging",
      "title": "Rig and animate a Rodin model",
      "description": "Generate a skeleton and skinning for an existing Rodin model, optionally adding stock or uploaded FBX animations. Reuses confirmed geometry and textures. Exports Basic (2K) textures with All materials when confirmed textures exist, otherwise no materials. This consumes credits and creates a new generation_id. Use rodin_get_status or rodin_wait, then rodin_get_result for downloads. Present display_url only after completion. If this call times out, do not retry it automatically; ask the user to check Hyper3D Mine.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid",
            "description": "The generation_id of your Rodin model with confirmed geometry. A new rigging task is created; the source is preserved. Provide exactly one of asset_id or model_upload_id."
          },
          "model_upload_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{21}[AEIMQUYcgkosw048]$",
            "description": "A mesh uploaded with rodin_create_uploads kind=model (GLB, OBJ, STL, FBX or USD), rigged instead of an existing generation. Provide exactly one of asset_id or model_upload_id."
          },
          "bone_template": {
            "type": "string",
            "enum": [
              "human",
              "quadruped",
              "human_UE",
              "human_Unity",
              "human_ActorCore",
              "bird",
              "dragon",
              "kaiju",
              "custom"
            ],
            "description": "Skeleton template. Use human_UE, human_Unity, or human_ActorCore for the corresponding human skeleton variant. Names are case-sensitive. custom requires skeleton_description; preset templates do not accept it."
          },
          "skeleton_description": {
            "type": "string",
            "minLength": 1,
            "description": "Body structure and limbs for a custom skeleton. Required only for bone_template=custom; omit for preset templates."
          },
          "skinning_method": {
            "type": "string",
            "enum": ["shell", "core"],
            "default": "shell",
            "description": "Skinning method. Defaults to shell."
          },
          "geometry_file_format": {
            "type": "string",
            "enum": ["glb", "fbx", "usdz"],
            "default": "glb",
            "description": "Output format for the rigged model. Defaults to glb."
          },
          "animation_preset": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 10,
            "description": "Distinct Standard Animation IDs from rodin_list_animation_presets compatible with the skeleton. Legacy preset IDs remain accepted and are normalized to the corresponding Standard Animation. Up to 10 presets; mutually exclusive with animation_upload_ids. Omit both to export without animations."
          },
          "animation_upload_ids": {
            "type": "array",
            "items": {
              "$ref": "#/properties/model_upload_id"
            },
            "maxItems": 10,
            "description": "Distinct FBX upload IDs from rodin_create_uploads with kind=animation after successful PUT uploads, or saved animations from rodin_list_uploads. Each file must contain one animation clip (Take) and already match the target rig; uploaded animations are not retargeted. Up to 10 files; mutually exclusive with animation_preset."
          }
        },
        "required": ["bone_template"],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generation_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "const": "queued"
          },
          "display_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["generation_id", "status", "display_url"],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": ["rodin:generate"]
          }
        ]
      }
    },
    {
      "name": "rodin_generate_bang",
      "title": "Generate BANG from a Rodin generation",
      "description": "Split a completed Rodin generation into parts with BANG. Pass the generation_id returned by rodin_generate as asset_id. This consumes credits. The response includes display_url; present that URL only after the BANG generation completes. If this call times out, do not retry it automatically; ask the user to check Hyper3D Mine.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid",
            "description": "The generation_id returned by rodin_generate for the completed model to split."
          },
          "instruction": {
            "type": "string",
            "description": "Optional comma-separated list of part names to separate. Provide only part names, for example: \"head, torso, left arm, right arm, legs\". Omit unless the user specifies which parts they want; omitting it uses the automatic split planner."
          },
          "strength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "default": 5,
            "description": "Soft target for how many parts BANG should produce."
          },
          "explode_strength": {
            "type": "number",
            "minimum": 0,
            "default": 1,
            "description": "Guidance strength for the BANG split plan."
          },
          "escore": {
            "type": "number",
            "description": "Optional texture complexity control."
          },
          "reference_scale": {
            "type": "number",
            "description": "Optional reference-image adherence control."
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "geometry_file_format": {
            "type": "string",
            "enum": ["glb", "usdz", "fbx", "obj", "stl"],
            "default": "glb"
          },
          "resolution": {
            "type": "string",
            "enum": ["Basic", "High"],
            "default": "Basic"
          }
        },
        "required": ["asset_id"],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generation_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "const": "queued"
          },
          "display_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["generation_id", "status", "display_url"],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "oauth2",
            "scopes": ["rodin:generate"]
          }
        ]
      }
    },
    {
      "name": "rodin_get_status",
      "title": "Get Rodin generation status",
      "description": "Read the state of a generation. When no job records remain, downloadable model files indicate completed; otherwise the state is unknown. stage contains a user-facing name plus a 1-based current position and stable total; current is 0 before the first stage starts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "generation_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["generation_id"],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generation_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "processing", "completed", "failed", "unknown"]
          },
          "stage": {
            "type": "object",
